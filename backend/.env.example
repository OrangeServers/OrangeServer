# =============================================================================
# OrangeServer 后端环境变量模板（v2 · REVIEW-15 P1-4 完整版）
# =============================================================================
# 💡 SETUP-WIZARD：从 v2.1 起支持首次部署网页向导——
#    必需项（MySQL 三项 / SECRET_KEY / FERNET_KEYS）可以**全部留空**，
#    直接启动服务后打开 http://<地址>:8080 会进入 /setup 配置向导，
#    在页面上完成配置并自动重启生效（配置写入 <数据目录>/runtime.env）。
#    本文件手工配置仍然有效且优先级更高（非空进程 env > runtime.env > .env）。
# =============================================================================
# ⚠️ 重要：以下默认值是**开发模式**示例（便于本地跑通），
#         生产部署前**必须修改**以下字段：
#   - OGS_ENV=prod                          （启动强校验 secret/fernet）
#   - OGS_FLASK_SECRET_KEY=<随机>=32字节>  （HMAC 签名密钥）
#   - OGS_FERNET_KEYS=<Fernet key>          （SSH 凭据加密，R1-22 后多 key rotation）
#   - OGS_MYSQL_HOST / PASSWORD             （不要 192.0.2.1 / app_user / YOUR_MYSQL_DEV_PASSWORD 等开发值）
#   - OGS_REDIS_HOST / PORT / PASSWORD      （生产建议配 requirepass）
#   - OGS_CSRF_ALLOWED_ORIGINS=https://...  （生产域名）
#   - OGS_HTTPS=true                        （Nginx 终止 TLS 时必填）
#
# 复制本文件为 .env（不要提交 .env 到 git），填入真实值覆盖默认行为。
# conf.py 和 init.py 会按以下顺序查找配置：
#   1) 进程环境变量  2) 项目根目录 .env 文件  3) 代码内置默认值（开发用）
#
# ############### 按部署模式填值参考（生产必读） ###############
# | 部署模式            | OGS_MYSQL_HOST       | OGS_MYSQL_PORT | OGS_REDIS_HOST        | OGS_REDIS_PORT | OGS_HTTPS |
# |---------------------|----------------------|----------------|------------------------|----------------|-----------|
# | Docker Compose       | mysql （compose 服务名）| 3306           | redis （compose 服务名）| 6379           | "true"    |
# | 物理机 + supervisor  | 127.0.0.1            | 3306           | 127.0.0.1              | 6379           | "true"    |
# | 仅后端 Docker        | host.docker.internal | 3306           | host.docker.internal   | 6379           | "true"    |
# | Kubernetes           | mysql.<ns>.svc...   | 3306           | redis.<ns>.svc...     | 6379           | "true"    |
# | 本地 dev （默认）     | 192.0.2.1           | 3306           | 192.0.2.1             | 6389           | "false"   |
# 注：
#   - 本文件中 OGS_MYSQL_HOST=192.0.2.1、OGS_REDIS_HOST=192.0.2.1、OGS_REDIS_PORT=6379
#     是**开发者本机 dev 默认值**，生产/多机部署时必须按上表改为对应模式的值。
#   - config.py 会 fail-fast 检查 OGS_MYSQL_USER / PASSWORD / HOST 是不是
#     占位符或硬编码值（192.0.2.1 等），遇到占位会启动失败。Redis 未做同样检查，
#     所以 Redis 那一组容易被遗忘——**不要只改 MySQL，Redis 也改**。
#
# REVIEW-15-P1-4: 补全 conf.py / csrf.py / init.py 全部 30+ OGS_* 变量
# REVIEW-15-P0-5:  P0-5 已移除 conf.py sed 替换，配置全部走 .env
# =============================================================================


# ============================================================
# ---------- Flask / Session ----------
# ============================================================
# 运行环境（dev / prod），生产必须设为 prod，否则跳过 FLASK_SECRET_KEY 强校验
OGS_ENV=dev

# Flask session/cookie 签名密钥。生产环境必须替换为长随机字符串（>=32 字节）
# 可用命令生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
OGS_FLASK_SECRET_KEY=

# Session 滑动过期时间（秒）。默认 3 小时 = 10800
OGS_SESSION_EXP_SECONDS=10800

# Session 自动续期阈值（0-1）。剩余 TTL < 阈值*总 TTL 时自动续期
# 默认 0.5 = 10800 * 0.5 = 5400 秒时续期
OGS_SESSION_RENEW_RATIO=0.5


# ============================================================
# ---------- Fernet (SSH 凭据对称加密) ----------
# ============================================================
# 用于 t_sys_user.host_password 加密（AES-128-CBC + HMAC-SHA256）
# 必须是 base64-url-safe 编码的 32 字节。生成命令：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# R1-22 (2026-07-01): 推荐 OGS_FERNET_KEYS（多 key 列表，支持 rotation）
#   - 第 1 个 key = 最新（用于加密新数据）
#   - 第 2..N 个 key = 历史（仅用于解密旧数据，触发透明迁移）
#   - 单 key 时 OGS_FERNET_KEY 也可继续使用（兼容路径）
#
# 重要：丢失所有 key = 所有已加密的 SSH 主机密码无法恢复，需重输。
#
# 多 key rotation 示例：
#   阶段 1（初始部署）：  OGS_FERNET_KEYS=<key1>
#   阶段 2（key1 风险）：OGS_FERNET_KEYS=<key2>,<key1>    # 业务侧自动迁移到 key2
#   阶段 3（迁移完成）：  OGS_FERNET_KEYS=<key2>          # 移除 key1
OGS_FERNET_KEYS=
# OGS_FERNET_KEY=<key1>   # 单 key 兼容模式 (不推荐)


# ============================================================
# ---------- MySQL ----------
# ============================================================
# ⚠️ 以下 OGS_MYSQL_HOST=192.0.2.1 / OGS_MYSQL_USER=app_user 是开发者本机 dev 默认值。
# 生产部署必须按顶部"按部署模式填值参考"表改为对应模式的值。
# config.py fail-fast 检查这三项是占位符/硬编码默认值时会启动失败。
#
# ⚠️ HOST 字段**不能含端口**：写 OGS_MYSQL_HOST=192.0.2.1:3306 是错的
#   端口单独放 OGS_MYSQL_PORT=3306。Docker compose 模式下 backend 容器
#   连容器名 mysql (OGS_MYSQL_HOST=mysql), 本机已有 mysql 用 host.docker.internal
OGS_MYSQL_HOST=192.0.2.1
OGS_MYSQL_PORT=3306
OGS_MYSQL_DBNAME=orange
OGS_MYSQL_USER=app_user
OGS_MYSQL_PASSWORD=


# ============================================================
# ---------- Redis ----------
# ============================================================
# ⚠️ 以下 OGS_REDIS_HOST=192.0.2.1 / OGS_REDIS_PORT=6379 是开发者本机 dev 默认值。
# 注：Redis 标准端口是 6379；代码内置 dev 默认是 6389（开发机自定义端口），按实际部署填写。
# 生产部署必须按顶部"按部署模式填值参考"表改为对应模式的值。
# config.py **不**对 Redis 做 fail-fast 检查，这组容易被遗忘——**要手动改**。
#
# ⚠️ HOST 字段**不能含端口**：写 OGS_REDIS_HOST=192.0.2.1:6379 是错的
#   端口单独放 OGS_REDIS_PORT=6379
# REV46-H12: 生产环境建议必填密码 (Redis requirepass), 防未授权访问
OGS_REDIS_HOST=192.0.2.1
OGS_REDIS_PORT=6379
OGS_REDIS_PASSWORD=
# bundled 栈固定 DB 2 存放业务会话和带 TTL 的缓存。
OGS_REDIS_DB=2
OGS_REDIS_MAX_CONNECTIONS=256
# REV46-H14: socket 超时 + keepalive, 防 hang 或长连接被中间设备切断
OGS_REDIS_SOCKET_TIMEOUT=5
OGS_REDIS_CONNECT_TIMEOUT=5
OGS_REDIS_SOCKET_KEEPALIVE=true


# ============================================================
# ---------- Mail (SMTP) ----------
# ============================================================
# OGS_MAIL_PASSWORD 实际是邮箱的 SMTP 授权码，不是登录密码
OGS_MAIL_USER=
OGS_MAIL_PASSWORD=
# REV48: 不用邮件功能就三项全空; 三项任一非空则启用 (MAIL_ENABLED)
#   (注释不要写在值同一行——部分 env 解析器会把行内注释并入值)
OGS_MAIL_SMTP=

# SMTP 端口 + 加密（REVIEW-13 P1-2）
# 587 = STARTTLS（推荐）  465 = SSL  25 = 裸连（生产禁用）
OGS_MAIL_PORT=587
OGS_MAIL_USE_TLS=true
OGS_MAIL_USE_SSL=false

# SMTP 连接 / 操作超时（REVIEW-13 P1-1 防慢 SMTP 阻塞）
OGS_SMTP_CONNECT_TIMEOUT=10
OGS_SMTP_OP_TIMEOUT=30

# 邮件中继限流（REVIEW-13 P0-2 防滥发）
OGS_MAIL_RELAY_LIMIT_MIN=5
OGS_MAIL_RELAY_LIMIT_HOUR=30

# 验证码 Redis key 前缀（防与其他业务 key 冲突）
OGS_MAIL_VERIFY_PREFIX=mail_verification:
OGS_MAIL_VERIFY_TTL=180

# 邮件长度上限（RFC 5321 路径 <254 字符）
OGS_EMAIL_MAX_LEN=254
OGS_HEADER_MAX_LEN=200
OGS_MESSAGE_MAX_LEN=10000


# ============================================================
# ---------- SSH / Remote (REVIEW-11) ----------
# ============================================================
# 主机 host key 策略：
#   reject  — 严格模式，拒绝未知主机 key（防 MITM，需提前配置 known_hosts）
#   auto    — 自动接受新主机 key（推荐运维堡垒机部署使用）
#   warning — 报警但放行（开发调试用）
# 注意：paramiko 4.x+ 不支持 ssh-rsa (SHA-1)，
#       连接旧版 OpenSSH (<6.5) 服务器可能需要升级目标服务器或降级 paramiko
OGS_SSH_HOST_KEY_POLICY=auto

# SSH 连接超时（秒）
OGS_SSH_CONNECT_TIMEOUT=10

# SSH keepalive 间隔（秒，0=禁用）
OGS_SSH_KEEPALIVE_INTERVAL=60

# ssh_cmd stdout/stderr 输出上限（字节，防 OOM）
OGS_SSH_CMD_MAX_OUTPUT_BYTES=10485760

# SSH 危险命令黑名单（逗号分隔）。生产只追加，不删默认项
OGS_SSH_DANGEROUS_COMMANDS=rm -rf /,mkfs,dd if=,shutdown,reboot,init 0,init 6,halt,poweroff,:(){:|:&};:,chmod -R 777 /,chown -R

# subprocess shell 编码（防二进制输出解码错误）
OGS_SUBPROCESS_ENCODING=utf-8


# ============================================================
# ---------- Login rate limit (REVIEW-6) ----------
# ============================================================
# 账号维度失败阈值（防单账号暴力破解）
OGS_LOGIN_FAIL_LIMIT=5

# IP 维度失败阈值（防公司 NAT 出口共享 IP 时误锁全公司）
OGS_LOGIN_FAIL_LIMIT_IP=20


# ============================================================
# ---------- Captcha (REVIEW-13 P1-3) ----------
# ============================================================
# CaptchaGet IP 限流（防 Redis 内存膨胀）
OGS_CAPTCHA_GET_LIMIT_MIN=10
OGS_CAPTCHA_GET_PREFIX_MIN=captcha_get_min:


# ============================================================
# ---------- CSRF (REVIEW-6 P2-2) ----------
# ============================================================
# Origin/Referer 白名单（逗号分隔），仅 scheme+netloc
# 例如 OGS_CSRF_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"
# dev 容器：浏览器只访问 Vite，同源代理保留原 Host，通常无需额外白名单
OGS_CSRF_ALLOWED_ORIGINS=


# ============================================================
# ---------- Cron / SFTP ----------
# ============================================================
# cron last_result Redis TTL（防永久膨胀 + 敏感命令输出残留）
OGS_CRON_RESULT_RETENTION=604800

# sftp 上传总大小限制（防磁盘填充 DoS，默认 200MB）
OGS_SFTP_MAX_UPLOAD_SIZE=209715200


# ============================================================
# ---------- HTTPS (REVIEW-6 P0-2) ----------
# ============================================================
# true / 1 / yes / on 任意一个即视为 HTTPS 模式
# 此时 Flask cookie 会自动加 Secure 标志（限 Chrome/Firefox/Edge 在 HTTPS 下写入）
# 仅当 Nginx 终止 TLS 反代 http 到 gunicorn 时才设 true
OGS_HTTPS=false

# ============================================================
# ---------- Proxy / CORS (REV43-H1 + REV43-H4) ----------
# ============================================================
# OGS_PROXY_LAYERS: 后端 ProxyFix 信任的反代层数（默认 0）
#   - 0 = 关闭 ProxyFix（标准 Compose 直连和本地开发）
#   - 1 = 1 层 nginx/LB 反代
#   - 2+ = 前面有 CDN/负载均衡器多层（按实际代理层数设置，**不要超过实际层数**否则日志/限流会被伪造）
OGS_PROXY_LAYERS=0

# OGS_CORS_ORIGINS: CORS 跨域白名单（REV43-H1）
#   逗号分隔, 仅 scheme+netloc（不含路径）
#   dev 容器: Vite 同源代理到 backend，保留原 Host
#   生产: 前端域名（https://your.domain.com），多个用逗号
#   留空 = 禁止跨域（仅同源访问）
OGS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ============================================================
# ---------- Paths ----------
# ============================================================
# 不设置时默认走当前工作目录下的 data/ 子目录
OGS_DATA_DIR=

# 默认命令（一般无需改，按部署环境调）
OGS_DEFAULT_DIR1_PATH=ls /data
OGS_DEFAULT_DIR2_PATH=ls /data/%s
OGS_RSYNC_SHELL_CMD=/usr/bin/rsync -av /data/%s/%s /data/tmp/
# AI Provider 默认只允许公网 HTTPS 地址，防止连接测试形成 SSRF 出口。
# 仅在明确使用内网模型网关时才设为 1，并限制该服务器的出网权限。
OGS_AI_ALLOW_PRIVATE_PROVIDER=0
# AI 诊断原始脱敏证据与结构化报告保留天数（1-3650）
OGS_AI_DIAGNOSTIC_EVIDENCE_RETENTION_DAYS=7
OGS_AI_DIAGNOSTIC_REPORT_RETENTION_DAYS=90
# M1 AI autonomy. Bundled Compose sets this true and starts Redis Stack + Worker.
# Empty/false keeps unit tests and non-compose processes from starting autonomy.
# Operators turn the product on/off in Settings; this env is the process kill switch.
OGS_AI_AUTONOMY_ENABLED=
# Dedicated autonomy Redis (not the business Redis 7).
# DB 0 stores LangGraph checkpoints; DB 1 is the Celery broker.
OGS_AI_AUTONOMY_REDIS_HOST=
OGS_AI_AUTONOMY_REDIS_PORT=6379
OGS_AI_AUTONOMY_REDIS_PASSWORD=
OGS_AUTONOMY_WORKER_CONCURRENCY=2
# M2/S1 optional alert intake. The owner must name an existing admin.
OGS_AI_ALERTMANAGER_TOKEN=
OGS_AI_ALERTMANAGER_OWNER=
# Optional Prometheus server. Queries remain server-owned and fixed.
OGS_AI_PROMETHEUS_BASE_URL=
OGS_AI_PROMETHEUS_BEARER_TOKEN=

# 物理机可按 CONFIG.md 设置 OGS_AI_EMBEDDING_MODEL_PATH；Docker 镜像已内置。

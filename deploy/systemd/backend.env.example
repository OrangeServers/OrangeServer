# OrangeServer systemd 环境模板 (REV49)
# 复制到 /etc/orangeserver/backend.env 后填写。
# 不得把真实值提交 Git。
# 权限: root:root 0600
#
# 💡 SETUP-WIZARD：必需项（MySQL 三项 / SECRET_KEY / FERNET_KEYS）可保持
#    __占位__ 或留空——首次启动会进入网页配置向导（/setup），在页面完成配置，
#    结果写入 <OGS_DATA_DIR>/runtime.env 并自动重启生效。
#    手工在本文件填真实值仍然优先于向导写入的 runtime.env。

# ---------- Flask / Session ----------
OGS_ENV=prod
OGS_FLASK_SECRET_KEY=__REQUIRED_GENERATE_RANDOM_48_BYTES__
OGS_SESSION_EXP_SECONDS=10800
OGS_SESSION_RENEW_RATIO=0.5

# ---------- Fernet (SSH 凭据加密) ----------
OGS_FERNET_KEYS=__REQUIRED_GENERATE_FERNET_KEY__

# ---------- MySQL ----------
OGS_MYSQL_HOST=127.0.0.1
OGS_MYSQL_PORT=3306
OGS_MYSQL_DBNAME=orange
OGS_MYSQL_USER=app_user
OGS_MYSQL_PASSWORD=__REQUIRED_EXISTING_APP_USER_PASSWORD__

# ---------- Redis ----------
OGS_REDIS_HOST=127.0.0.1
OGS_REDIS_PORT=6379
OGS_REDIS_PASSWORD=__FILL_IF_REDIS_REQUIRES_AUTH__
OGS_REDIS_DB=2
OGS_REDIS_MAX_CONNECTIONS=10
OGS_REDIS_SOCKET_TIMEOUT=5
OGS_REDIS_CONNECT_TIMEOUT=5
OGS_REDIS_SOCKET_KEEPALIVE=true

# ---------- Mail (三项全空=禁用) ----------
OGS_MAIL_USER=
OGS_MAIL_PASSWORD=
OGS_MAIL_SMTP=
OGS_MAIL_PORT=587
OGS_MAIL_USE_TLS=true
OGS_MAIL_USE_SSL=false

# ---------- 数据目录 ----------
OGS_DATA_DIR=/data/orangeserver
OGS_DEFAULT_DIR1_PATH=ls /data
OGS_DEFAULT_DIR2_PATH=ls /data/%s
OGS_RSYNC_SHELL_CMD=/usr/bin/rsync -av /data/%s/%s /data/tmp/

# ---------- HTTPS / Proxy ----------
# 本模板配合 deploy/nginx/orange_server.conf（单层 HTTPS 反代）使用。
OGS_HTTPS=true
OGS_PROXY_LAYERS=1
OGS_CORS_ORIGINS=
OGS_CSRF_ALLOWED_ORIGINS=

# ---------- SSH ----------
OGS_SSH_HOST_KEY_POLICY=reject
OGS_SSH_CONNECT_TIMEOUT=10
OGS_SSH_KEEPALIVE_INTERVAL=60

# ---------- 编码 ----------
OGS_SUBPROCESS_ENCODING=utf-8
# 仅私有模型网关部署需要改为 1；公网厂商保持 0。
OGS_AI_ALLOW_PRIVATE_PROVIDER=0

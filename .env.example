# =============================================================================
# OrangeServer 根 .env.example（顶层整合）
# =============================================================================
# 本文件供 docker compose 变量替换使用。子项目各自的 .env.example：
#   - backend/.env.example    后端 30+ OGS_* 配置（后端进程加载）
#   - frontend/.env.development  前端 Vite dev
#   - frontend/.env.production   前端 Vite build
#
# ⚠️ 本文件与 backend/.env 的关键区别：
#   - 本文件：docker compose 变量替换（${OGS_MYSQL_PASSWORD} 等）
#   - backend/.env：后端 Flask 进程加载（OGS_FLASK_SECRET_KEY / OGS_FERNET_KEYS 等）
#   - OGS_MYSQL_PASSWORD 两处填相同值（mysql 容器以 root 为 app_user 设密码）
#   - MYSQL_ROOT_PASSWORD 仅填本文件（容器 root 账号，与业务账号不同）
#
# 用法：
#   cp .env.example .env
#   chmod 600 .env
#   编辑 .env 后 make docker-up
# =============================================================================

# ---------- Docker compose ----------
COMPOSE_PROJECT_NAME=orangeserver

# ---------- 后端镜像 ----------
# 源码检出的 make docker-up 保持注释并从 backend/Dockerfile 本地构建。
# 使用公开预构建镜像时取消注释，并固定到已发布的稳定版本：
# OGS_BACKEND_IMAGE=ghcr.io/orangeservers/orangeserver-backend
# OGS_BACKEND_TAG=v1.0.4

# ---------- 公共依赖镜像 ----------
# 全球线路默认使用 Docker Hub 官方镜像。仅在部署网络需要指定镜像源时覆盖完整引用；
# 不要只填写 registry 前缀。中国大陆一键入口会自动写入已验证的公共镜像引用。
OGS_REDIS_IMAGE=redis:8.10.0-alpine
OGS_MYSQL_IMAGE=mysql:8.0.42

# ---------- 前端端口（宿主机映射，默认 8080 避免抢占 80/443）----------
OGS_HTTP_PORT=8080

# ---------- MySQL root 密码（mysql 容器 root 账号）----------
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ---------- 后端业务数据库账号（与 backend/.env 一致）----------
OGS_MYSQL_HOST=mysql
OGS_MYSQL_PORT=3306
OGS_MYSQL_DBNAME=orange
OGS_MYSQL_USER=app_user
OGS_MYSQL_PASSWORD=CHANGE_ME

# ---------- Redis（与 backend/.env 一致）----------
OGS_REDIS_HOST=redis
OGS_REDIS_PORT=6379
OGS_REDIS_DB=2
OGS_REDIS_PASSWORD=CHANGE_ME

# ---------- AI 自治（标准 bundled 栈默认启用；UI 可关）----------
OGS_AI_AUTONOMY_ENABLED=true
OGS_AI_AUTONOMY_REDIS_HOST=redis
OGS_AI_AUTONOMY_REDIS_PORT=6379
OGS_AUTONOMY_WORKER_CONCURRENCY=2
# 可选：Alertmanager 机器入口与固定 Prometheus 查询代理
OGS_AI_ALERTMANAGER_TOKEN=
OGS_AI_ALERTMANAGER_OWNER=
OGS_AI_PROMETHEUS_BASE_URL=
OGS_AI_PROMETHEUS_BEARER_TOKEN=

# ---------- HTTPS（试运行 false，生产 Nginx/LB 终止 TLS 后改 true）----------
OGS_HTTPS=false

# ---------- 前端 Vite (仅影响 npm run build，不影响已编译的 dist/) ----------
# VITE_API_BASE_URL=/api
# VITE_WS_BASE_URL=/ws
